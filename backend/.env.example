# ────────────────────────────────────────────────────────────────────────────
# LLM Agent Configuration
# ────────────────────────────────────────────────────────────────────────────
# The LangGraph agent reads these at runtime.  To switch providers just
# uncomment the block you need and fill in your API key.

# ── Option 1: Google Gemini ────────────────────────────────────────────────
# LLM_PROVIDER=google
# LLM_MODEL=gemini-2.0-flash
# LLM_API_KEY=your-google-api-key

# ── Option 2: OpenAI or OpenAI-compatible endpoint (Gemma, local LLM, etc.) ─
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=your-api-key
# LLM_BASE_URL=https://api.openai.com/v1       # default for OpenAI
# LLM_BASE_URL=https://your-endpoint.example/v1 # custom / local endpoint

# ── Auth Configuration ─────────────────────────────────────────────────────
# Path to the SQLite auth database (default: auth.db)
# In Docker, use /data/auth.db with a mounted volume
# DATABASE_URL=/data/auth.db
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Session lifetime in days (default: 7)
# SESSION_EXPIRY_DAYS=7

# Comma-separated list of extra public paths that bypass auth
# AUTH_PUBLIC_PATHS=/health,/ready

# ── Generic ────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
